# 실제 Gemini 호출에만 필요합니다.
GEMINI_API_KEY="발급받은-키를-여기에-입력"

# 모델별로 다른 키를 선택하려면 아래처럼 별도 환경변수를 만들고,
# CLI의 --target-api-key-env / --optimizer-api-key-env에는 변수 이름만 전달합니다.
# GEMINI_KEY_A="첫-번째-키"
# GEMINI_KEY_B="두-번째-키"

# NVIDIA API Catalog의 hosted NIM을 사용할 때만 필요합니다.
# NVIDIA_NIM_API_KEY="발급받은-키를-여기에-입력"

# Ollama Cloud 직접 API를 사용할 때만 필요합니다.
# OLLAMA_API_KEY="발급받은-키를-여기에-입력"

# DeepEval의 로컬 실행 설정입니다.
DEEPEVAL_DISABLE_DOTENV=1
DEEPEVAL_TELEMETRY_OPT_OUT=YES
